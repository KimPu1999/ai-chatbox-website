APP_NAME=PyChat AI
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://pychat:pychat@localhost:5432/pychat
TEST_DATABASE_URL=
ALLOWED_ORIGINS=["http://localhost:5173"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=1024
AI_CONTEXT_TOKEN_BUDGET=8000
AI_MAX_REQUESTS_PER_MINUTE=10
AI_MAX_CONCURRENT_GENERATIONS=2
AI_DAILY_TOKEN_BUDGET=100000
AI_ALLOWED_MODELS=
AI_PRICING_VERSION=unpriced-v1
REDIS_URL=
LOG_LEVEL=INFO

# Authentication
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
COOKIE_SECURE=false

# Frontend
FRONTEND_URL=http://localhost:5173

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Verification and Recovery
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=12
AUTH_RATE_LIMIT_PER_MINUTE=10
PASSWORD_BREACH_CHECK_ENABLED=false
PASSWORD_BREACH_API_URL=https://api.pwnedpasswords.com/range
