APP_NAME=PyChat AI
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://pychat:pychat@localhost:5432/pychat
TEST_DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:5173
OPENAI_API_KEY=your_real_openai_key
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DOCUMENT_MAX_UPLOAD_MB=20
DOCUMENT_MAX_PAGES=200
DOCUMENT_CHUNK_TOKENS=500
DOCUMENT_CHUNK_OVERLAP=75
DOCUMENT_RETRIEVAL_TOP_K=5
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./storage/private
DOCUMENT_MAX_FILES_PER_USER=100
DOCUMENT_MAX_STORAGE_MB_PER_USER=500
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
DOCUMENT_MAX_CSV_ROWS=100000
DOCUMENT_MAX_CSV_COLUMNS=100
DOCUMENT_MAX_EXTRACTED_CHARACTERS=5000000
DOCUMENT_PROCESSING_ENABLED=true
DOCUMENT_MALWARE_SCAN_REQUIRED=false
LOG_LEVEL=INFO
